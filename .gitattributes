# Text normalization
* text=auto eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Original DCC source files and approved binary exports
ArtSource/**/*.blend filter=lfs diff=lfs merge=lfs -text lockable
ArtSource/**/*.fbx filter=lfs diff=lfs merge=lfs -text lockable
ArtSource/**/*.obj filter=lfs diff=lfs merge=lfs -text
ArtSource/**/*.spp filter=lfs diff=lfs merge=lfs -text lockable
ArtSource/**/*.psd filter=lfs diff=lfs merge=lfs -text lockable
ArtSource/**/*.tif filter=lfs diff=lfs merge=lfs -text
ArtSource/**/*.tiff filter=lfs diff=lfs merge=lfs -text
ArtSource/**/*.exr filter=lfs diff=lfs merge=lfs -text
ArtSource/**/*.tga filter=lfs diff=lfs merge=lfs -text
ArtSource/**/*.png filter=lfs diff=lfs merge=lfs -text

# Game-ready binary character assets
Game/Assets/**/*.fbx filter=lfs diff=lfs merge=lfs -text lockable
Game/Assets/**/*.blend filter=lfs diff=lfs merge=lfs -text lockable
Game/Assets/**/*.psd filter=lfs diff=lfs merge=lfs -text lockable
Game/Assets/**/*.tif filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.tiff filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.exr filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.tga filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.png filter=lfs diff=lfs merge=lfs -text

# Unity YAML assets remain mergeable text
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
